<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Everything stays inside the 72dp adaptive-icon safe zone (18..90). -->

    <!-- Dim track, same relationship as CircularGauge's track to its progress arc. -->
    <path
        android:pathData="M54,25.5 A28.5,28.5 0 1,1 53.97,25.5"
        android:strokeWidth="5"
        android:strokeColor="#2600D89F"
        android:strokeLineCap="round" />

    <!-- 270 degree gauge sweep, opening at the bottom. -->
    <path
        android:pathData="M33.85,74.15 A28.5,28.5 0 1,1 74.15,74.15"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="25"
                android:startY="80"
                android:endX="83"
                android:endY="28">
                <item android:offset="0.0" android:color="#FF8A5CFF" />
                <item android:offset="0.5" android:color="#FF13C8E8" />
                <item android:offset="1.0" android:color="#FF00D89F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pulse trace through the middle. -->
    <path
        android:pathData="M33,54 L42.5,54 L47,43.5 L54,66 L60,48.5 L64.5,54 L75,54"
        android:strokeWidth="4.5"
        android:strokeColor="#FFF5F7FB"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
